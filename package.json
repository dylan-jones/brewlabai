{
  "name": "brew-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/openai": "^4.0.96",
    "@ducanh2912/next-pwa": "latest",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@opennextjs/cloudflare": "latest",
    "ai": "^7.0.143",
    "better-auth": "^1.7.11",
    "brewcalc": "0.1.6",
    "idb-keyval": "^6.2.2",
    "lucide-react": "latest",
    "next": "^16.4.2",
    "patch-package": "^8.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "styled-components": "^6.1.19",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "flatted": "^3.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-call": "^1.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.9.3",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
